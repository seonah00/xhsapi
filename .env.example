# Copy to .env.local for local development. Never commit real secrets.
# Default is mock mode: no external provider/LLM/email/payment calls.
APP_DATA_MODE=mock
LIVE_PROVIDER_CALLS_ENABLED=false
LIVE_LLM_CALLS_ENABLED=false
AUTO_REFRESH_ENABLED=false
COMMENTS_ENABLED=false
OCR_ENABLED=false
# F15 video audio transcript (RF13/RF14) live calls. Mock works regardless.
TRANSCRIPT_ENABLED=false
PUBLIC_SIGNUP_ENABLED=false
OUTBOUND_EMAIL_ENABLED=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Server-side only. Having a key does NOT enable live mode.
REDFOX_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
WORKER_ENABLED=true

# --- Login and storage (see docs/DEPLOY.md) ---
# demo = seeded demo accounts (mock data only). supabase = real e-mail + password login (required for live).
AUTH_PROVIDER=demo
# local = private directory; supabase = private Supabase Storage bucket
STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=private-assets
# Public origin for one-time links (invitations, password links). https in deployment.
APP_BASE_URL=
# Signs the session cookie. 32+ random characters; required outside demo mode.
SESSION_SECRET=

# Supabase CA certificate (PEM text) to verify the database server over TLS (docs/DEPLOY.md 1-6)
DATABASE_CA_CERT=

# Optional Zen Studio note enrichment; token belongs on worker only.
APIFY_ENABLED=false
APIFY_TOKEN=
# Pin a reviewed Actor build number, e.g. the exact number from Apify Builds.
APIFY_ACTOR_BUILD=

# Shared dictionary composer: OFF until deployment/budget approval.
# Server-only Gemini key; never NEXT_PUBLIC_ and never committed as a real value.
DICTIONARY_AI_ENABLED=false
GEMINI_API_KEY=
# Initial rollout ceilings are fixed in the server config: 3 requests/user/KST day,
# US$5 total/month across organizations, using conservative reserved upper bounds.
# Also requires APP_DATA_MODE=live, AUTH_PROVIDER=supabase, LIVE_LLM_CALLS_ENABLED=true,
# and the organization's live/AI switches with kill switch off.
