# syntax=docker/dockerfile:1
# worker image for Railway (or any container host). Secrets come from the platform's
# environment at runtime; nothing secret is baked into the image.
FROM node:22-bookworm-slim AS deps
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/core/package.json packages/core/
COPY packages/domain/package.json packages/domain/
COPY packages/providers/package.json packages/providers/
COPY packages/security/package.json packages/security/
RUN pnpm install --frozen-lockfile
COPY . .
ENV NODE_ENV=production
USER node
CMD ["node", "scripts/start.mjs", "worker"]
