# syntax=docker/dockerfile:1
# web image for Railway (or any container host). Secrets come from the platform's
# environment at runtime; nothing secret is baked into the image.
FROM node:22-bookworm-slim AS deps
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/core/package.json packages/core/
COPY packages/domain/package.json packages/domain/
COPY packages/providers/package.json packages/providers/
COPY packages/security/package.json packages/security/
RUN pnpm install --frozen-lockfile
COPY . .
# Build-time values that end up in headers (HSTS on https). Not secret.
ARG APP_BASE_URL
ENV APP_BASE_URL=$APP_BASE_URL NODE_ENV=production
RUN pnpm --filter @xhs/web build
RUN chown -R node:node /app/apps/web/.next
USER node
EXPOSE 3000
CMD ["node", "scripts/start.mjs", "web"]
